# Forms. Without RESEND_API_KEY and CONTACT_FROM the forms tell the visitor to phone or e-mail instead.
RESEND_API_KEY=
# Optional: messages go to the e-mail address in content/temple.yml unless this is set.
CONTACT_TO=
# The verified sender for Resend, for example "Mandir Triloki Dhaam <website@trilokidhaam.nl>".
CONTACT_FROM=
# Set to 1 once the content has been checked and the site may appear in search engines.
SITE_INDEXABLE=
# The public address of the site, for example https://trilokidhaam.nl
SITE_URL=
