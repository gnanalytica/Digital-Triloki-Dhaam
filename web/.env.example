# Forms. Each message becomes a row in the mandir's Google Sheet; see google-sheet/Code.gs for the set-up.
# Without the URL the forms tell the visitor to phone or e-mail instead. The secret is an optional extra lock.
SHEET_WEBHOOK_URL=
SHEET_SECRET=
# Set to 1 once the content has been checked and the site may appear in search engines.
SITE_INDEXABLE=
# The public address of the site, for example https://trilokidhaam.nl
SITE_URL=
